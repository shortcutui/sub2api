COMPOSE_PROJECT_NAME=sub2api-test
# 从 Fork images 工作流的摘要复制实际镜像，不要使用此占位值。
SUB2API_IMAGE=ghcr.io/shortcutui/sub2api:dev-替换为提交号
BIND_HOST=0.0.0.0
SERVER_PORT=8080
TZ=Asia/Shanghai

# 分别使用 openssl rand -hex 32 生成以下四个值。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
TOTP_ENCRYPTION_KEY=

ADMIN_EMAIL=admin@example.com
# 首次初始化时使用，8–72 字节；已有管理员时不会重置密码。
ADMIN_PASSWORD=
